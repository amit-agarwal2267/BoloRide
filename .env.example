# ============================================================
# BoloRide - Application
# ============================================================

APP_NAME=BoloRide
APP_ENV=development
APP_PORT=8000
# Production Compose binds the operational API to loopback by default.
APP_BIND_ADDRESS=127.0.0.1

DEBUG=false

# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO
# Production deployment must override this with LOG_LEVEL=ERROR.
# The production voice-worker command also sets LIVEKIT_LOG_LEVEL=error.
LOG_FORMAT=json

# File logging is intentionally disabled; containers log JSON to stdout.

# ============================================================
# Database
# ============================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=boloride
POSTGRES_USER=boloride
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+asyncpg://boloride:change_me@postgres:5432/boloride
DATABASE_CONNECT_TIMEOUT_SECONDS=3
PROVIDER_CALL_LEASE_SECONDS=30


# ============================================================
# LiveKit
# ============================================================

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=boloride-dev
# Temporary development identity until participant/telephony identification is added.
DEVELOPMENT_CALLER_PHONE=+919876543210

# ============================================================
# Shared Providers
# ============================================================

GROQ_API_KEY=

# ============================================================
# STT
# ============================================================

STT_PROVIDER=assemblyai

ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STT_MODEL=universal-streaming-multilingual
# Leave blank for multilingual auto-detection.
STT_LANGUAGE=


# ============================================================
# LLM Routing
# ============================================================

LLM_PRIMARY_PROVIDER=google
LLM_PRIMARY_MODEL=
# To select OpenAI: LLM_PRIMARY_PROVIDER=openai and LLM_PRIMARY_MODEL=gpt-5.6-luna

LLM_FALLBACK_1_PROVIDER=google
LLM_FALLBACK_1_MODEL=

LLM_FALLBACK_2_PROVIDER=groq
LLM_FALLBACK_2_MODEL=

GOOGLE_API_KEY=
OPENAI_API_KEY=

LLM_TIMEOUT_SECONDS=15
# Per route. Provider SDK retries are disabled to avoid stacked retries.
LLM_MAX_RETRIES=1


# ============================================================
# TTS
# ============================================================

TTS_PROVIDER=sarvam
TTS_VOICE=hi-IN-SwaraNeural
TTS_MALE_VOICE=hi-IN-MadhurNeural
TTS_FEMALE_VOICE=hi-IN-SwaraNeural
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TIMEOUT_SECONDS=10
SARVAM_TTS_MALE_SPEAKER=amit
SARVAM_TTS_FEMALE_SPEAKER=ritu
# auto selects once per session from the approved catalogue; use a speaker ID
# such as amit or pooja only for an explicit fixed-persona test.
TTS_PERSONA=auto


# ============================================================
# Langfuse SDK
# ============================================================

LANGFUSE_ENABLED=true

# From host machine:
# http://localhost:3000
#
# From BoloRide Docker container:
# http://langfuse-web:3000

LANGFUSE_HOST=http://langfuse-web:3000
# Public browser URL used by the production Langfuse web deployment.
LANGFUSE_PUBLIC_URL=https://langfuse.example.com
LANGFUSE_WEB_PORT=3000

# Created after creating your Langfuse project
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Allows prompt updates without rebuilding BoloRide
LANGFUSE_PROMPT_LABEL=development
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300
LANGFUSE_TIMEOUT_SECONDS=5

# Local fallback prompts if Langfuse is unavailable
PROMPT_FALLBACK_ENABLED=true


# ============================================================
# Langfuse Internal Configuration
# ============================================================

LANGFUSE_NEXTAUTH_SECRET=change_me
LANGFUSE_SALT=change_me

# MUST be a 64-character hex value
# Generate:
# openssl rand -hex 32

LANGFUSE_ENCRYPTION_KEY=

# Optional local/CI headless initialization. Use development-only credentials.
LANGFUSE_INIT_ORG_ID=boloride
LANGFUSE_INIT_ORG_NAME=BoloRide
LANGFUSE_INIT_PROJECT_ID=boloride-development
LANGFUSE_INIT_PROJECT_NAME=BoloRide Development
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=developer@example.com
LANGFUSE_INIT_USER_NAME=BoloRide Developer
LANGFUSE_INIT_USER_PASSWORD=


# ============================================================
# Langfuse PostgreSQL
# ============================================================

LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=change_me


# ============================================================
# Langfuse ClickHouse
# ============================================================

LANGFUSE_CLICKHOUSE_DB=default
LANGFUSE_CLICKHOUSE_USER=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=change_me


# ============================================================
# Langfuse Redis
# ============================================================

LANGFUSE_REDIS_PASSWORD=change_me


# ============================================================
# Langfuse MinIO
# ============================================================

LANGFUSE_MINIO_ACCESS_KEY=langfuse
LANGFUSE_MINIO_SECRET_KEY=change_me_with_long_random_value


# ============================================================
# Maps / Location Resolution
# ============================================================

MAPS_PROVIDER=ola
GOOGLE_MAPS_API_KEY=
OLA_MAPS_API_KEY=
MAPS_TIMEOUT_SECONDS=10
MAPS_MAX_CANDIDATES=5
MAPS_URBAN_CONTEXT_RADIUS_METERS=1000
MAPS_RURAL_CONTEXT_RADIUS_METERS=20000

DEFAULT_COUNTRY=IN
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=Asia/Kolkata


# ============================================================
# Telephony
# ============================================================

# console | browser | twilio | exotel
TELEPHONY_PROVIDER=console
LIVEKIT_SIP_TRUNK_ID=
# Demo-only server-owned identity. Never sent by or exposed to the browser.
BROWSER_DEMO_CALLER_PHONE=
WEB_DEMO_PORT=3100

# Twilio and LiveKit SIP resources are provisioned manually. BoloRide does not
# use Twilio REST credentials at runtime; see docs/twilio-livekit-setup.md.

# Exotel DID and SIP mapping are provisioned outside the application; see
# docs/exotel-livekit-setup.md. No Exotel runtime credential is consumed.

# Never put real production secrets in .env.example
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=